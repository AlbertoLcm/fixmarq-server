generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes", "views"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model budget_items {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  budget_id   String    @db.Uuid
  description String
  quantity    Decimal   @default(1.00) @db.Decimal(10, 2)
  unit        String    @default("Pza") @db.VarChar(50)
  price       Decimal   @default(0.00) @db.Decimal(12, 2)
  total       Decimal?  @default(dbgenerated("(quantity * price)")) @db.Decimal(12, 2)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  budgets     budgets   @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([budget_id], map: "idx_budget_items_budget_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model budget_payments {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  budget_id    String    @db.Uuid
  payment_date DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  amount       Decimal   @db.Decimal(12, 2)
  description  String    @default("Abono a cuenta de obra") @db.VarChar(255)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  budgets      budgets   @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([budget_id], map: "idx_budget_payments_budget_id")
}

model budgets {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  project_name    String            @db.VarChar(255)
  client_name     String            @db.VarChar(255)
  budget_date     DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  total_amount    Decimal           @default(0.00) @db.Decimal(12, 2)
  paid_amount     Decimal           @default(0.00) @db.Decimal(12, 2)
  status          budget_status     @default(pending)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  budget_items    budget_items[]
  budget_payments budget_payments[]

  @@index([status], map: "idx_budgets_status")
}

view view_budget_analytics {
  id           String?        @db.Uuid
  created_at   DateTime?      @db.Timestamptz(6)
  project_name String?        @db.VarChar(255)
  client_name  String?        @db.VarChar(255)
  total_amount Decimal?       @db.Decimal(12, 2)
  paid_amount  Decimal?       @db.Decimal(12, 2)
  balance_due  Decimal?       @db.Decimal
  status       budget_status?
  percent_paid Decimal?       @db.Decimal
}

enum budget_status {
  pending
  ongoing
  paid
}
